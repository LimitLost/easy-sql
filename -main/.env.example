# PostgreSQL Test Database Configuration
# Copy this file to .env and fill in your actual values
# PostgreSQL hostname/IP used by integration tests
POSTGRES_HOST=localhost
# PostgreSQL TCP port used by integration tests
POSTGRES_PORT=5432
# PostgreSQL username used by integration tests
POSTGRES_USER=your_username
# PostgreSQL password used by integration tests
POSTGRES_PASSWORD=your_password
# Test DB names use this prefix plus a generated unique suffix; prefix may be truncated to fit PostgreSQL's 63-byte identifier limit
POSTGRES_TEST_DB_PREFIX=easy_sql_test

# Test isolation mode. Default (unset) is schema-per-test: one shared database with a separate Postgres SCHEMA
# per test — faster, and avoids the leaked databases / connection-exhaustion hangs of a whole database per test.
# Set EASY_SQL_PG_DEBUG=true for the database-per-test path instead: one test maps to one dedicated, inspectable
# database, which is easier to debug after a failure.
# EASY_SQL_PG_DEBUG=true
# Name of the single shared database used by schema-per-test isolation (created automatically if missing).
# POSTGRES_TEST_DB=easy_sql_shared_test
